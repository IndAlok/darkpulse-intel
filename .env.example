# DarkPulse - Environment Configuration
# Copy to .env and set real values before deployment.

# Service
DARKPULSE_ENVIRONMENT=development
DARKPULSE_LOG_LEVEL=INFO
DARKPULSE_API_HOST=0.0.0.0
DARKPULSE_API_PORT=8080
# Origin of the deployed frontend, required by production CORS and the
# WebSocket origin check.
DARKPULSE_FRONTEND_ORIGIN=http://localhost:5173

# Processor
# Poll interval for the MongoDB-backed raw-ingest processor in seconds.
DARKPULSE_PROCESSOR_POLL_INTERVAL_SECONDS=2.0
# Minutes a claimed record stays leased before another attempt.
DARKPULSE_PROCESSOR_LEASE_MINUTES=15
# Maximum processing attempts before a record is marked exhausted.
DARKPULSE_PROCESSOR_MAX_ATTEMPTS=5
DARKPULSE_CONTRACT2_PATH=contracts/contract2-intel.schema.json

# Redis
DARKPULSE_REDIS_URL=redis://redis:6379/0

# MongoDB
DARKPULSE_MONGODB_URI=mongodb://mongodb:27017
DARKPULSE_MONGODB_DATABASE=darkpulse

# Neo4j
DARKPULSE_NEO4J_URI=bolt://neo4j:7687
DARKPULSE_NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_set_a_real_password

# Models
DARKPULSE_MURIL_MODEL=google/muril-base-cased
DARKPULSE_INDICNER_MODEL=ai4bharat/IndicNER
DARKPULSE_FASTTEXT_LID_PATH=/app/models/lid.176.bin
DARKPULSE_INTENT_MODEL_PATH=/app/models/intent_classifier.joblib
DARKPULSE_MODEL_DEVICE=cpu

# Slang
DARKPULSE_SLANG_SEED_PATH=/app/data/slang_dictionary/seed_dictionary.txt
DARKPULSE_SLANG_AUTO_DISCOVERY_ENABLED=true
DARKPULSE_SLANG_SIMILARITY_THRESHOLD=0.7
DARKPULSE_SLANG_MIN_OCCURRENCES=3

# Geo
DARKPULSE_GEO_GAZETTEER=builtin
DARKPULSE_GEO_CITY=Surat

# Severity weights
DARKPULSE_SEVERITY_INTENT=0.25
DARKPULSE_SEVERITY_PRODUCT_HARM=0.20
DARKPULSE_SEVERITY_SOURCE_RELIABILITY=0.15
DARKPULSE_SEVERITY_LOCALIZATION=0.15
DARKPULSE_SEVERITY_RECENCY=0.10
DARKPULSE_SEVERITY_EXPOSURE=0.15

# Collection
DARKPULSE_COLLECTOR_ID=darkpulse-collector
DARKPULSE_COLLECTOR_VERSION=1.0.0
DARKPULSE_DEDUP_TTL_SECONDS=7776000
DARKPULSE_CONTRACT_PATH=/app/contracts/contract1-raw-ingest.schema.json
DARKPULSE_SAFETY_POLICY_PATH=/app/safety/policy/prepublish-v1.json
DARKPULSE_SOURCES_PATH=/app/config/sources.json
DARKPULSE_ONION_REVIEW_POLICY_PATH=/app/config/onion-review.json
DARKPULSE_TOR_PROXY_URL=socks5://localhost:9050

# Telegram (optional - only for authorized public-channel collection)
DARKPULSE_TELEGRAM_API_ID=
DARKPULSE_TELEGRAM_API_HASH=
DARKPULSE_TELEGRAM_RUNTIME_ROOT=/app/runtime/telegram
DARKPULSE_TELEGRAM_SESSION_PATH=/app/runtime/telegram/darkpulse
DARKPULSE_TELEGRAM_MAX_MESSAGES=100

# Evidence
DARKPULSE_RFC3161_ENABLED=false
DARKPULSE_RFC3161_TSA_URL=

# API access control. Keep disabled only for local development. Production
# startup refuses to run without this configured. Prefer an OIDC gateway for
# managed identity, expiry, MFA and revocation, the token map is a deployment
# fallback and must be stored in a secret manager, never committed. Example:
# {"replace-with-long-random-token":{"subject":"analyst-001","role":"analyst"}}
DARKPULSE_AUTH_ENABLED=false
DARKPULSE_AUTH_TOKENS_JSON=

# Frontend
VITE_API_URL=/api/v1
# Bearer token the frontend sends on every API request and the alerts
# WebSocket. Only required when the API runs with DARKPULSE_AUTH_ENABLED=true.
VITE_API_TOKEN=
# Runtime overrides read by the containerized frontend (config.js at startup).
# The nginx container proxies /api to BACKEND_UPSTREAM (same-origin).
DARKPULSE_API_URL=
DARKPULSE_API_TOKEN=
BACKEND_UPSTREAM=http://backend:8080

# Evolution loader
EVOLUTION_DATASET_DIR=./data/evolution
EVOLUTION_LIMIT=1000

# Grafana (observability profile)
GRAFANA_PASSWORD=CHANGE_ME_set_a_real_password

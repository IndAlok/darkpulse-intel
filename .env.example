# DarkPulse environment. Copy to .env and replace every CHANGE_ME value.
# Values below target a process running on the host. docker-compose.yml
# overrides the datastore URLs with in-network service names.

# Service
DARKPULSE_ENVIRONMENT=development
DARKPULSE_LOG_LEVEL=INFO
DARKPULSE_API_HOST=127.0.0.1
DARKPULSE_API_PORT=8080
# Allowed browser origin for CORS and the alerts WebSocket. Production must use https.
DARKPULSE_FRONTEND_ORIGIN=http://localhost:5173

# Access control. Auth is required unless DARKPULSE_LOCAL_OPEN_MODE=true, which
# is accepted only on a loopback bind outside production. Each token must be at
# least 32 random characters. Store the map in a secret manager.
DARKPULSE_AUTH_ENABLED=true
DARKPULSE_AUTH_TOKENS_JSON={"CHANGE_ME_analyst_token_at_least_32_chars":{"subject":"analyst-001","role":"analyst"}}
DARKPULSE_LOCAL_OPEN_MODE=false

# Processor
DARKPULSE_PROCESSOR_POLL_INTERVAL_SECONDS=2.0
DARKPULSE_PROCESSOR_LEASE_MINUTES=15
DARKPULSE_PROCESSOR_MAX_ATTEMPTS=5
DARKPULSE_CONTRACT2_PATH=contracts/contract2-intel.schema.json

# Datastores (host ports published by docker-compose.yml)
REDIS_PASSWORD=CHANGE_ME_redis_password
DARKPULSE_REDIS_URL=redis://:CHANGE_ME_redis_password@localhost:16379/0
MONGO_ROOT_USER=darkpulse
MONGO_ROOT_PASSWORD=CHANGE_ME_mongo_password
DARKPULSE_MONGODB_URI=mongodb://darkpulse:CHANGE_ME_mongo_password@localhost:27017/?authSource=admin
DARKPULSE_MONGODB_DATABASE=darkpulse
# Completed and dropped raw records expire after this many days. Pending and failed rows never expire.
DARKPULSE_RAW_RETENTION_DAYS=30
DARKPULSE_NEO4J_URI=bolt://localhost:7687
DARKPULSE_NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_neo4j_password

# Models. Intent uses rules unless a trained joblib file exists at this path.
DARKPULSE_FASTTEXT_LID_PATH=/app/models/lid.176.bin
DARKPULSE_INTENT_MODEL_PATH=/app/models/intent_classifier.joblib

# Slang. Analysts add terms in the desk; automatic discovery is off.
DARKPULSE_SLANG_SEED_PATH=data/slang_dictionary/seed_dictionary.txt

# Geo
DARKPULSE_GEO_GAZETTEER=builtin
DARKPULSE_GEO_CITY=Surat

# Severity weights. They must sum to 1.0.
DARKPULSE_SEVERITY_INTENT=0.25
DARKPULSE_SEVERITY_PRODUCT_HARM=0.20
DARKPULSE_SEVERITY_SOURCE_RELIABILITY=0.15
DARKPULSE_SEVERITY_LOCALIZATION=0.15
DARKPULSE_SEVERITY_RECENCY=0.10
DARKPULSE_SEVERITY_EXPOSURE=0.15

# Collection
DARKPULSE_COLLECTOR_ID=darkpulse-collector
DARKPULSE_COLLECTOR_VERSION=1.0.0
DARKPULSE_DEDUP_TTL_SECONDS=7776000
DARKPULSE_CONTRACT_PATH=contracts/contract1-raw-ingest.schema.json
DARKPULSE_SAFETY_POLICY_PATH=safety/policy/prepublish-v1.json
DARKPULSE_SOURCES_PATH=config/sources.json
DARKPULSE_ONION_REVIEW_POLICY_PATH=config/onion-review.json
DARKPULSE_TOR_PROXY_URL=socks5://localhost:9050
COLLECT_INTERVAL=300

# Telegram, only for authorized public-channel collection. Leave blank to disable.
DARKPULSE_TELEGRAM_API_ID=
DARKPULSE_TELEGRAM_API_HASH=
DARKPULSE_TELEGRAM_RUNTIME_ROOT=runtime/telegram
DARKPULSE_TELEGRAM_SESSION_PATH=runtime/telegram/darkpulse
DARKPULSE_TELEGRAM_MAX_MESSAGES=100

# Evidence. RFC 3161 timestamping is not implemented; startup refuses true.
DARKPULSE_RFC3161_ENABLED=false
DARKPULSE_RFC3161_TSA_URL=

# Frontend container. Leave empty to proxy /api on the same origin.
DARKPULSE_API_URL=
BACKEND_UPSTREAM=http://backend:8080

# Evolution loader
EVOLUTION_DATASET_DIR=./data/evolution
EVOLUTION_LIMIT=1000

# Grafana (observability profile)
GRAFANA_PASSWORD=CHANGE_ME_grafana_password
